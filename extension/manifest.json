{
  "manifest_version": 3,
  "name": "书签归位 · AI Bookmark Steward",
  "version": "0.2.0",
  "description": "按实际用途整理Chrome书签栏，先预览再应用，保留原书签并支持撤销。",
  "minimum_chrome_version": "134",
  "permissions": [
    "bookmarks",
    "storage",
    "activeTab"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "书签归位 - AI 整理书签，收藏自动选文件夹",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "打开智能收藏"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
