{
  "manifest_version": 3,
  "name": "书签归位 · AI Bookmark Steward",
  "version": "0.2.0",
  "description": "按实际用途整理Chrome书签栏，先预览再应用，保留原书签并支持撤销。",
  "minimum_chrome_version": "134",
  "permissions": [
    "bookmarks",
    "storage",
    "activeTab"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "智能收藏 · 先确认去向",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "打开智能收藏"
    }
  }
}
